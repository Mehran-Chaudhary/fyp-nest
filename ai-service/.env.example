# DAIAP AI service. Copy to `.env` (local) or set on your host.

# ── Required ─────────────────────────────────────────────────────────────────
# Must equal the backend's AI_SERVICE_SIGNING_SECRET and AI_SERVICE_KEY_ID.
AI_SERVICE_SIGNING_SECRET=
AI_SERVICE_KEY_ID=v1

# ── Models (labels from app/models/registry.py) ──────────────────────────────
# The backend's EMBEDDING_MODEL and EMBEDDING_DIMENSIONS must be identical.
EMBEDDING_MODEL=embeddinggemma-300m-int8
# 0 = native (768 for EmbeddingGemma). 512/256/128 truncate (Matryoshka).
EMBEDDING_DIMENSIONS=0
# bge-reranker-base | jina-reranker-v1-turbo-en | ms-marco-MiniLM-L-6-v2 | none
RERANK_MODEL=bge-reranker-base
PII_ENABLED=true
PII_SPACY_MODEL=en_core_web_md
# Transformer NER beside spaCy: bert-base-NER | none
PII_TRANSFORMER_MODEL=bert-base-NER
OCR_ENABLED=true
OCR_MAX_PAGES=50
MODEL_CACHE_DIR=.models
# false in the container image: models are baked in at build time.
MODEL_DOWNLOAD=true
MODEL_WAIT_SECONDS=25
# ONNX Runtime threads per model; 0 = one per CPU core.
ONNX_THREADS=0

# ── Secret rotation (optional) ───────────────────────────────────────────────
AI_SERVICE_PREVIOUS_SIGNING_SECRET=
AI_SERVICE_PREVIOUS_KEY_ID=

# ── Several replicas (optional): share replay protection through Redis ───────
REPLAY_REDIS_URL=

# ── Limits and concurrency ───────────────────────────────────────────────────
MAX_DOCUMENT_BYTES=67108864
PARSE_CONCURRENCY=2
EMBED_CONCURRENCY=1
RERANK_CONCURRENCY=1
PII_CONCURRENCY=2
CHUNK_CONTEXT_HEADERS=true

# ── Server ───────────────────────────────────────────────────────────────────
PORT=8000
LOG_LEVEL=INFO
LOG_FORMAT=json
DOCS_ENABLED=false
