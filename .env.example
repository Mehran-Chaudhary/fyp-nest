###############################################################################
#  Distributed AI Agent Management Platform — Backend configuration
#
#  Copy to `.env` and adjust:      cp .env.example .env
#  Then generate real secrets:     npm run generate:secrets -- --write
#
#  Every variable below is validated at boot by `src/config/env.validation.ts`.
#  The process REFUSES TO START on invalid configuration — a backend running
#  with a missing signing secret is far more dangerous than one that does not
#  run at all.
#
#  Variables marked [REQUIRED IN PRODUCTION] fall back to obviously-fake
#  development values otherwise, and the application logs a loud warning when it
#  uses one.
###############################################################################


# ═══════════════════════════════════════════════════════════════════════════
#  APPLICATION
# ═══════════════════════════════════════════════════════════════════════════

NODE_ENV=development
APP_NAME="Distributed AI Agent Management Platform"
APP_PORT=3000
APP_HOST=0.0.0.0

# Mounted in front of every route: /api/v1/auth/login
APP_GLOBAL_PREFIX=api
APP_API_VERSION=1

# Public base URL of THIS API. Used in Swagger's server list.
APP_URL=http://localhost:3000

# Public base URL of the React frontend. Used to build the links inside
# verification, password-reset and invitation emails — get this wrong and those
# emails point nowhere.
FRONTEND_URL=http://localhost:5173

# Grace period for in-flight requests during a graceful shutdown.
APP_SHUTDOWN_TIMEOUT=10s

# Hard ceiling on any single request. LLM inference routes get their own,
# longer budget when they arrive in phase 3.
REQUEST_TIMEOUT=30s
JSON_BODY_LIMIT=2mb


# ═══════════════════════════════════════════════════════════════════════════
#  OBSERVABILITY
# ═══════════════════════════════════════════════════════════════════════════

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug

# Coloured human-readable logs. Set false wherever logs are shipped to a
# collector, which needs the raw JSON.
LOG_PRETTY=true
LOG_HTTP_REQUESTS=true

SWAGGER_ENABLED=true
SWAGGER_PATH=docs
SWAGGER_JSON_PATH=docs-json


# ═══════════════════════════════════════════════════════════════════════════
#  POSTGRESQL                                                      [REQUIRED]
# ═══════════════════════════════════════════════════════════════════════════

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=ai_agent_platform
DB_SCHEMA=public

# TLS to the database. Required by most managed providers (Neon, Supabase, RDS).
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
# PEM *contents*, not a file path, when a provider needs a specific CA trusted.
DB_SSL_CA=

# Logs every SQL statement. Very noisy; useful when debugging a query.
DB_LOGGING=false

# NEVER enable outside a throwaway database. Migrations own the schema, and
# `synchronize` will silently drop columns and the audit log's immutability
# triggers. It is additionally force-disabled in production by the config layer.
DB_SYNCHRONIZE=false

# Run pending migrations automatically on boot. Convenient in Docker; prefer an
# explicit `npm run migration:run` step in a real deployment pipeline.
DB_MIGRATIONS_RUN=false

DB_POOL_MAX=20
DB_POOL_IDLE_TIMEOUT=30s
DB_CONNECTION_TIMEOUT=10s
# Server-side ceiling; the last defence against one query pinning a connection
# and starving the pool.
DB_STATEMENT_TIMEOUT=30s


# ═══════════════════════════════════════════════════════════════════════════
#  REDIS                                                           [REQUIRED]
#
#  Carries caching, rate-limit buckets, the token-revocation overlay, and (from
#  phase 2) the BullMQ queues that process documents. Use a managed Redis with
#  TLS (REDIS_URL=rediss://...) and maxmemory-policy noeviction.
#
#  Every read path has a documented fallback, so a Redis outage degrades the
#  platform rather than stopping it — see the notes in redis.service.ts.
# ═══════════════════════════════════════════════════════════════════════════

# When set, takes precedence over every REDIS_* field below.
# e.g. rediss://default:password@host:6379
REDIS_URL=

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0

# The proposal calls for "TLS-secured message brokers" for inter-agent
# communication. This is that switch.
REDIS_TLS=false
REDIS_TLS_REJECT_UNAUTHORIZED=true
REDIS_TLS_CA=

# Namespaces every key. Keep the trailing colon.
REDIS_KEY_PREFIX=daiap:
REDIS_CONNECT_TIMEOUT=10s
REDIS_MAX_RETRIES_PER_REQUEST=3


# ═══════════════════════════════════════════════════════════════════════════
#  JWT                                       [REQUIRED IN PRODUCTION]
#
#  Access and refresh tokens are signed with DIFFERENT secrets. Reusing one
#  would let a stolen refresh token be replayed as an access token, defeating
#  rotation and reuse detection entirely.
#
#  Generate both with:  npm run generate:secrets -- --write
# ═══════════════════════════════════════════════════════════════════════════

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Short by design: revocation latency is bounded by this value.
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

JWT_ISSUER=daiap
JWT_AUDIENCE=daiap-api
JWT_ALGORITHM=HS256
JWT_CLOCK_TOLERANCE=5


# ═══════════════════════════════════════════════════════════════════════════
#  SECURITY                                  [REQUIRED IN PRODUCTION]
# ═══════════════════════════════════════════════════════════════════════════

# ── Password hashing ───────────────────────────────────────────────────────
# argon2id is the OWASP first choice and the default. Switch to `scrypt` only
# if the argon2 native addon cannot be built on your deployment target —
# existing hashes stay verifiable either way and are upgraded on next sign-in.
PASSWORD_HASH_ALGORITHM=argon2id

# Memory cost in KiB. 65536 = 64 MiB, the OWASP baseline. Raising it makes
# offline cracking proportionally more expensive and sign-in proportionally
# slower; measure before changing.
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=4

# ── Password policy ────────────────────────────────────────────────────────
PASSWORD_MIN_LENGTH=12
PASSWORD_MAX_LENGTH=128
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_NUMBER=true
# Off by default: symbol requirements push users toward `Password1!` patterns
# that composition rules accept and attackers try first. Length does more.
PASSWORD_REQUIRE_SYMBOL=false

# Optional server-side pepper mixed into every password hash. Because it lives
# outside the database, a stolen dump alone is not enough for an offline attack.
# CHANGING IT INVALIDATES EVERY STORED PASSWORD.
PASSWORD_PEPPER=

# ── Keys ───────────────────────────────────────────────────────────────────
# AES-256-GCM key for encrypted columns. Accepts 64 hex chars, 32 base64 bytes,
# or any passphrase (stretched with scrypt).
# ROTATING IT ORPHANS EVERY EXISTING CIPHERTEXT.
ENCRYPTION_KEY=

# HMAC key protecting the tamper-evident audit log hash chain. Lives outside the
# database on purpose: an attacker with database access alone cannot recompute a
# consistent chain to hide an edit.
# ROTATING IT MAKES EVERY EXISTING RECORD FAIL VERIFICATION.
AUDIT_HASH_SECRET=

# ── Account lockout ────────────────────────────────────────────────────────
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_DURATION=15m
LOGIN_ATTEMPT_WINDOW=15m

# ── One-time tokens ────────────────────────────────────────────────────────
EMAIL_VERIFICATION_TTL=24h
PASSWORD_RESET_TTL=1h
INVITATION_TTL=7d

# Blocks unverified accounts from everything. Off by default so a new
# installation is usable before SMTP is configured; turn on for production.
REQUIRE_EMAIL_VERIFICATION=false

# ── API keys ───────────────────────────────────────────────────────────────
API_KEY_PREFIX=daiap_sk
API_KEY_DEFAULT_TTL=365d

# ── Refresh token cookie ───────────────────────────────────────────────────
# httpOnly means script cannot read it, so an XSS flaw in the React app cannot
# exfiltrate a 30-day credential. Non-browser clients use the response body copy.
REFRESH_TOKEN_COOKIE_ENABLED=true
REFRESH_TOKEN_COOKIE_NAME=daiap_rt
REFRESH_TOKEN_COOKIE_DOMAIN=

# BOTH MUST CHANGE FOR PRODUCTION: COOKIE_SECURE=true, COOKIE_SAME_SITE=strict
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_SECRET=

# ── CORS ───────────────────────────────────────────────────────────────────
# Comma-separated. `*` allows any origin and is development-only — with
# credentials enabled it lets any website act as a signed-in user.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
CORS_CREDENTIALS=true

# ── Network ────────────────────────────────────────────────────────────────
# Number of reverse proxies in front of the app. MUST be correct: the IP
# allowlist and the rate limiter both read the resolved client IP, and a wrong
# value makes both either useless or spoofable.
#   0     no proxy (direct)
#   1     one proxy (nginx, a single load balancer)  <- typical
#   true  trust the whole X-Forwarded-For chain (only on a trusted network)
TRUST_PROXY=1

# Master switch for per-workspace IP allowlisting (proposal module 6.1).
# Individual workspaces still opt in themselves.
ENFORCE_IP_ALLOWLIST=true

HELMET_ENABLED=true
HSTS_MAX_AGE=15552000


# ═══════════════════════════════════════════════════════════════════════════
#  RATE LIMITING  (proposal module 6.14 foundation)
# ═══════════════════════════════════════════════════════════════════════════

THROTTLE_ENABLED=true

# General API traffic, per authenticated principal or source IP.
THROTTLE_TTL=60s
THROTTLE_LIMIT=120

# Credential endpoints: sign-in, refresh, password reset. Deliberately tight.
THROTTLE_AUTH_TTL=15m
THROTTLE_AUTH_LIMIT=10

# Endpoints that send email, so the platform cannot be used as a spam relay.
THROTTLE_EMAIL_TTL=1h
THROTTLE_EMAIL_LIMIT=5

# Document uploads (each costs storage, parsing and embedding downstream).
THROTTLE_UPLOAD_TTL=1h
THROTTLE_UPLOAD_LIMIT=100

# Retrieval queries (each costs an embedding call and a vector search).
THROTTLE_RAG_TTL=60s
THROTTLE_RAG_LIMIT=60

# Model calls: agent turns and direct chat (each holds a GPU slot for seconds).
THROTTLE_INFERENCE_TTL=60s
THROTTLE_INFERENCE_LIMIT=20

# PII analysis previews and redaction reports.
THROTTLE_PII_TTL=60s
THROTTLE_PII_LIMIT=30


# ═══════════════════════════════════════════════════════════════════════════
#  OUTBOUND EMAIL
#
#  `log` prints messages — including the verification and invitation links —
#  straight to the console and sends nothing. That is the right default for
#  development: it removes the usual onboarding blocker where a new contributor
#  cannot complete registration because nobody gave them SMTP credentials.
# ═══════════════════════════════════════════════════════════════════════════

# log | smtp
MAIL_TRANSPORT=log

MAIL_FROM_NAME="AI Agent Platform"
MAIL_FROM_ADDRESS=no-reply@localhost
MAIL_REPLY_TO=

# Required when MAIL_TRANSPORT=smtp.
SMTP_HOST=
SMTP_PORT=587
# true for implicit TLS on 465; false for STARTTLS on 587.
SMTP_SECURE=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_REJECT_UNAUTHORIZED=true


# ═══════════════════════════════════════════════════════════════════════════
#  BOOTSTRAP & LIMITS
# ═══════════════════════════════════════════════════════════════════════════

# `npm run seed` provisions a platform administrator when BOTH are set. There is
# deliberately no built-in default admin account.
# The password is checked against the live policy, so it must be a real one.
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=
PLATFORM_ADMIN_NAME="Platform Administrator"

# Seeds a demo workspace with five accounts and two custom roles that
# demonstrate the RBAC model. Ignored when NODE_ENV=production.
SEED_DEMO_DATA=false

# Workspaces one non-admin user may own.
MAX_OWNED_ORGANIZATIONS=5
# Members per workspace. 0 means unlimited.
MAX_MEMBERS_PER_ORGANIZATION=0


###############################################################################
#  PHASE 2 — KNOWLEDGE LAYER (documents, embeddings, secure retrieval)
#
#  Every variable here is OPTIONAL AT BOOT. The API starts and serves phase 1
#  without them; document upload and retrieval answer 503
#  KNOWLEDGE_LAYER_NOT_CONFIGURED, naming the missing variables, until the three
#  services below are provisioned. Step-by-step: docs/CLOUD_SETUP.md.
###############################################################################

# ═══════════════════════════════════════════════════════════════════════════
#  OBJECT STORAGE — any S3-compatible provider
#
#  Cloudflare R2 (recommended: 10 GB free, no egress fees), AWS S3, Backblaze
#  B2, Supabase Storage, Wasabi or MinIO. Files are encrypted by this service
#  BEFORE upload; the provider only ever holds ciphertext.
# ═══════════════════════════════════════════════════════════════════════════

# Setting the bucket is what switches uploads on.
STORAGE_S3_BUCKET=
# Empty for AWS itself. R2: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
STORAGE_S3_ENDPOINT=
# R2: auto. AWS: your bucket's region, e.g. eu-central-1.
STORAGE_S3_REGION=auto
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
# true for MinIO and some B2 setups.
STORAGE_S3_FORCE_PATH_STYLE=false
# AWS only: AES256 | aws:kms. Leave empty on R2/B2 (they encrypt at rest anyway).
STORAGE_S3_SERVER_SIDE_ENCRYPTION=
# Every object key starts with this, so one bucket can serve several deployments.
STORAGE_KEY_PREFIX=daiap/

UPLOAD_MAX_FILE_SIZE=50mb
# Subset of: pdf, docx, txt, md. The type is detected from file CONTENT;
# the client's Content-Type header is ignored.
UPLOAD_ALLOWED_TYPES=pdf,docx,txt,md
# Upload requests get a longer time budget than REQUEST_TIMEOUT.
UPLOAD_REQUEST_TIMEOUT=120s
# Total document bytes per workspace. 0 = unlimited.
STORAGE_QUOTA_PER_ORGANIZATION=1gb


# ═══════════════════════════════════════════════════════════════════════════
#  PYTHON AI SERVICE — parsing, chunking, embeddings, (optional) reranking
#
#  Contract: docs/contracts/ai-service-v1.md. Every request is HMAC-signed;
#  set the SAME AI_SERVICE_SIGNING_SECRET on the AI service.
# ═══════════════════════════════════════════════════════════════════════════

# e.g. https://daiap-ai.onrender.com  (no trailing slash)
AI_SERVICE_URL=
# [REQUIRED IN PRODUCTION when AI_SERVICE_URL is set] ≥ 32 chars.
# Generate with: npm run generate:secrets
AI_SERVICE_SIGNING_SECRET=
# Sent with each request so the secret can be rotated without downtime.
AI_SERVICE_KEY_ID=v1
AI_SERVICE_TIMEOUT=30s
# Parsing a long scanned PDF can legitimately take minutes.
AI_SERVICE_PARSE_TIMEOUT=300s
AI_SERVICE_MAX_RETRIES=2
AI_SERVICE_MAX_RESPONSE_SIZE=64mb
# Circuit breaker: after this many consecutive failures, fail fast for the cooldown.
AI_SERVICE_CIRCUIT_THRESHOLD=5
AI_SERVICE_CIRCUIT_COOLDOWN=30s


# ═══════════════════════════════════════════════════════════════════════════
#  VECTOR STORE — Qdrant Cloud (free 1 GB cluster is enough for the FYP)
# ═══════════════════════════════════════════════════════════════════════════

# e.g. https://<cluster-id>.<region>.aws.cloud.qdrant.io:6333
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION_PREFIX=daiap_
# collection: one collection per workspace (physical isolation; default).
# shared:     one collection, tenant-indexed (Qdrant's advice at 100s of workspaces).
QDRANT_TENANCY=collection
QDRANT_TIMEOUT=15s
# int8 scalar quantisation: ~4x less vector memory, rescored for accuracy.
QDRANT_QUANTIZATION=scalar
QDRANT_CIRCUIT_THRESHOLD=5
QDRANT_CIRCUIT_COOLDOWN=20s

# MUST match the model the AI service embeds with. Changing either later
# requires re-indexing every document (see docs/CLOUD_SETUP.md).
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768
EMBEDDING_BATCH_SIZE=32


# ═══════════════════════════════════════════════════════════════════════════
#  BACKGROUND PROCESSING — BullMQ on the Redis configured above
#
#  Redis MUST use `maxmemory-policy noeviction` (Redis Cloud: set it in the
#  database config; Upstash: leave eviction disabled), or queued jobs can be
#  silently evicted under memory pressure.
# ═══════════════════════════════════════════════════════════════════════════

# Defaults to `${REDIS_KEY_PREFIX}bull`.
QUEUE_PREFIX=
# true: this process also processes documents (simplest: one service).
# false: API only — run `npm run start:worker:prod` as a separate service.
QUEUE_WORKERS_ENABLED=true
INGESTION_CONCURRENCY=2
INGESTION_MAX_ATTEMPTS=5
INGESTION_BACKOFF_DELAY=15s
INGESTION_JOB_TIMEOUT=30m
INGESTION_MAX_CHUNKS=20000
# Token-based chunking defaults (workspace settings and knowledge bases override).
CHUNK_SIZE_DEFAULT=512
CHUNK_OVERLAP_DEFAULT=64
# Reconciliation sweep: re-enqueues lost jobs, resumes stalled ones, finishes purges.
MAINTENANCE_SWEEP_INTERVAL=5m
INGESTION_STALL_THRESHOLD=45m
# How long a deleted workspace's documents survive before being destroyed.
ORGANIZATION_PURGE_GRACE=7d


# ═══════════════════════════════════════════════════════════════════════════
#  SECURE RETRIEVAL (module 6.6)
# ═══════════════════════════════════════════════════════════════════════════

RAG_DEFAULT_TOP_K=8
RAG_MAX_TOP_K=50
# hybrid: dense vectors + BM25 keywords, fused with reciprocal rank fusion.
RAG_SEARCH_MODE=hybrid
# Candidates fetched per final result when reranking.
RAG_CANDIDATE_MULTIPLIER=4
# Requires the AI service to implement /v1/rerank.
RAG_RERANK_ENABLED=false
RAG_MAX_QUERY_LENGTH=2000
# Audit which documents the access policy WITHHELD from each query (ids only).
RAG_AUDIT_WITHHELD=true
RAG_WITHHELD_SCORE_THRESHOLD=0.35
RAG_REQUEST_TIMEOUT=60s


###############################################################################
#  PHASE 3 — INFERENCE, AGENTS & PRIVACY (LLM gateway, agents, memory, PII)
#
#  Every variable here is OPTIONAL AT BOOT. Without LLM_BASE_URL the model
#  endpoints answer 503 LLM_NOT_CONFIGURED; without an NER detector, the PII
#  policy decides (refuse by default). Step-by-step: docs/CLOUD_SETUP.md.
###############################################################################

# ═══════════════════════════════════════════════════════════════════════════
#  LLM GATEWAY (module 6.7) — the only way anything reaches a language model
#
#  Every prompt is masked by the PII engine and re-checked at this boundary
#  before it leaves; answers stream back over SSE and are unmasked for the
#  user. Nothing is sent to a model this deployment has not been told about.
# ═══════════════════════════════════════════════════════════════════════════

# ollama: Ollama's native API (self-hosted GPU, or Ollama Cloud).
# openai: any OpenAI-compatible server — vLLM, TGI, llama.cpp, LM Studio, or a
#         hosted open-weight provider (Groq, Together, Fireworks, OpenRouter).
LLM_PROVIDER=ollama
# ollama: the server root, no path     e.g. https://ollama.example.com
# openai: including the version path   e.g. https://api.together.xyz/v1
# Setting this is what switches inference on.
LLM_BASE_URL=
# Bearer token: your authenticating proxy in front of Ollama, Ollama Cloud's
# key, or the hosted provider's API key. Ollama itself has NO authentication —
# never expose a bare Ollama port to the internet.
LLM_API_KEY=
# Used when neither the agent nor the workspace names a model.
LLM_DEFAULT_MODEL=llama3.1:8b
# Comma-separated platform allowlist. Empty: whatever the endpoint serves.
# Workspaces can narrow it further (PUT …/llm/policy), never widen it.
LLM_ALLOWED_MODELS=
# The context window requested from the model (Ollama's num_ctx). Ollama
# silently uses 2-4k if not told, dropping the START of long prompts.
LLM_DEFAULT_CONTEXT_WINDOW=8192
# Ceiling on any context window requested; bounds GPU memory per request.
LLM_MAX_CONTEXT_WINDOW=32768
LLM_DEFAULT_MAX_OUTPUT_TOKENS=1024
LLM_MAX_OUTPUT_TOKENS=4096
LLM_DEFAULT_TEMPERATURE=0.3
# Until the first token — includes loading the model on a cold GPU.
LLM_FIRST_TOKEN_TIMEOUT=120s
# Longest silence between tokens once the answer has started.
LLM_IDLE_TIMEOUT=30s
# Hard ceiling on one generation.
LLM_MAX_DURATION=240s
# HTTP budget of the inference routes. MUST exceed LLM_MAX_DURATION by ≥ 10s
# (validated at boot). Proxies in front of the API need an idle timeout of at
# least 60s for streams; the stream sends a heartbeat every 15s.
LLM_REQUEST_TIMEOUT=300s
# Bulkhead: concurrent generations per API process. A GPU serves a handful at
# once; more only slows every answer down. Excess requests queue briefly,
# then get 503 LLM_BUSY with Retry-After.
LLM_MAX_CONCURRENCY=4
LLM_QUEUE_TIMEOUT=30s
# Retries happen only BEFORE the first token; never mid-answer.
LLM_MAX_RETRIES=1
LLM_MAX_RESPONSE_SIZE=4mb
LLM_CIRCUIT_THRESHOLD=5
LLM_CIRCUIT_COOLDOWN=30s
# Ollama only: how long a model stays loaded after a request (avoids cold loads).
LLM_KEEP_ALIVE=30m
# The most sensitive classification whose (masked) content may be sent to this
# endpoint. RESTRICTED for a model you host yourself; lower it — INTERNAL or
# PUBLIC — for a third-party API, and RESTRICTED passages are then never
# retrieved for a prompt at all.
LLM_MAX_CLASSIFICATION=RESTRICTED
# How long the endpoint's model list is cached.
LLM_MODEL_CACHE_TTL=60s


# ═══════════════════════════════════════════════════════════════════════════
#  PII REDACTION ENGINE (module 6.12) — detect, mask, unmask
#
#  Structural data (cards, IBANs, CNIC/SSN, phones, emails, IPs, salaries,
#  credentials) is found in-process by validated recognizers. NAMES need an NER
#  model, provided by the AI service (/v1/pii/analyze) or a Presidio analyzer.
#  Workspaces tune their own policy (entity types, allow/deny lists, failure
#  mode) via PUT …/pii/policy; these are the defaults until they do.
# ═══════════════════════════════════════════════════════════════════════════

# ai-service: the Python AI service's /v1/pii/analyze (HMAC-signed; recommended).
# presidio:   a stock Microsoft Presidio analyzer container (private network!).
# none:       pattern recognizers only; names are never detected.
PII_NER_PROVIDER=ai-service
# presidio only: e.g. http://presidio-analyzer.railway.internal:3000
# The stock image has NO authentication: keep it on a private network, or put
# an authenticating proxy in front and set its token below.
PRESIDIO_ANALYZER_URL=
PRESIDIO_API_KEY=
PRESIDIO_CONCURRENCY=4
PII_TIMEOUT=10s
PII_CIRCUIT_THRESHOLD=5
PII_CIRCUIT_COOLDOWN=30s
# Default entity types. Also available: LOCATION, ORGANIZATION, NRP (via NER),
# FINANCIAL_AMOUNT (any amount of money; masks prices too).
PII_DEFAULT_ENTITIES=PERSON,EMAIL_ADDRESS,PHONE_NUMBER,CREDIT_CARD,IBAN_CODE,US_SSN,PK_CNIC,IP_ADDRESS,SALARY,CREDENTIAL
# When the NER detector is unavailable:
#   REFUSE              — fail closed: nothing is sent (the default, and the safe one)
#   DEGRADE_TO_PATTERNS — continue with pattern detection only; names go unmasked
# There is deliberately no "send unmasked" option.
PII_DEFAULT_ON_FAILURE=REFUSE
PII_SCORE_THRESHOLD=0.5
PII_LANGUAGE=en
# NER results cached in Redis under a keyed digest — offsets and types only,
# never text. 0 disables.
PII_DETECTION_CACHE_TTL=1h
# Ceiling on text submitted to POST …/pii/analyze (the redaction preview).
PII_MAX_ANALYZE_LENGTH=20000


# ═══════════════════════════════════════════════════════════════════════════
#  AGENTS & MEMORY (modules 6.8, 6.10)
# ═══════════════════════════════════════════════════════════════════════════

# Recent messages an agent considers by default (each agent can change it),
# and the ceiling any agent may set. The real limit is the token budget below.
AGENT_MEMORY_MAX_MESSAGES=20
AGENT_MEMORY_MAX_MESSAGES_CEILING=100
# Default token budget for conversation history in a prompt.
AGENT_MEMORY_MAX_TOKENS=3000
# Default token budget for retrieved passages in a prompt.
AGENT_CONTEXT_MAX_TOKENS=3000
# Longest user message accepted, in characters.
AGENT_MAX_MESSAGE_LENGTH=16000


###############################################################################
#  LATER PHASES — not read by any code yet
#
#  Listed so the shape of the finished system is visible from day one, and so
#  infrastructure can be provisioned ahead of the module that needs it.
