###############################################################################
#  Distributed AI Agent Management Platform — Backend configuration
#
#  Copy to `.env` and adjust:      cp .env.example .env
#  Then generate real secrets:     npm run generate:secrets -- --write
#
#  Every variable below is validated at boot by `src/config/env.validation.ts`.
#  The process REFUSES TO START on invalid configuration — a backend running
#  with a missing signing secret is far more dangerous than one that does not
#  run at all.
#
#  Variables marked [REQUIRED IN PRODUCTION] fall back to obviously-fake
#  development values otherwise, and the application logs a loud warning when it
#  uses one.
###############################################################################


# ═══════════════════════════════════════════════════════════════════════════
#  APPLICATION
# ═══════════════════════════════════════════════════════════════════════════

NODE_ENV=development
APP_NAME="Distributed AI Agent Management Platform"
APP_PORT=3000
APP_HOST=0.0.0.0

# Mounted in front of every route: /api/v1/auth/login
APP_GLOBAL_PREFIX=api
APP_API_VERSION=1

# Public base URL of THIS API. Used in Swagger's server list.
APP_URL=http://localhost:3000

# Public base URL of the React frontend. Used to build the links inside
# verification, password-reset and invitation emails — get this wrong and those
# emails point nowhere.
FRONTEND_URL=http://localhost:5173

# Grace period for in-flight requests during a graceful shutdown.
APP_SHUTDOWN_TIMEOUT=10s

# Hard ceiling on any single request. LLM inference routes get their own,
# longer budget when they arrive in phase 3.
REQUEST_TIMEOUT=30s
JSON_BODY_LIMIT=2mb


# ═══════════════════════════════════════════════════════════════════════════
#  OBSERVABILITY
# ═══════════════════════════════════════════════════════════════════════════

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug

# Coloured human-readable logs. Set false wherever logs are shipped to a
# collector, which needs the raw JSON.
LOG_PRETTY=true
LOG_HTTP_REQUESTS=true

SWAGGER_ENABLED=true
SWAGGER_PATH=docs
SWAGGER_JSON_PATH=docs-json


# ═══════════════════════════════════════════════════════════════════════════
#  POSTGRESQL                                                      [REQUIRED]
# ═══════════════════════════════════════════════════════════════════════════

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=ai_agent_platform
DB_SCHEMA=public

# TLS to the database. Required by most managed providers (Neon, Supabase, RDS).
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
# PEM *contents*, not a file path, when a provider needs a specific CA trusted.
DB_SSL_CA=

# Logs every SQL statement. Very noisy; useful when debugging a query.
DB_LOGGING=false

# NEVER enable outside a throwaway database. Migrations own the schema, and
# `synchronize` will silently drop columns and the audit log's immutability
# triggers. It is additionally force-disabled in production by the config layer.
DB_SYNCHRONIZE=false

# Run pending migrations automatically on boot. Convenient in Docker; prefer an
# explicit `npm run migration:run` step in a real deployment pipeline.
DB_MIGRATIONS_RUN=false

DB_POOL_MAX=20
DB_POOL_IDLE_TIMEOUT=30s
DB_CONNECTION_TIMEOUT=10s
# Server-side ceiling; the last defence against one query pinning a connection
# and starving the pool.
DB_STATEMENT_TIMEOUT=30s


# ═══════════════════════════════════════════════════════════════════════════
#  REDIS                                                           [REQUIRED]
#
#  Carries caching, rate-limit buckets and the token-revocation overlay today,
#  and the BullMQ queues of the multi-agent workflow engine from phase 4.
#
#  Every read path has a documented fallback, so a Redis outage degrades the
#  platform rather than stopping it — see the notes in redis.service.ts.
# ═══════════════════════════════════════════════════════════════════════════

# When set, takes precedence over every REDIS_* field below.
# e.g. rediss://default:password@host:6379
REDIS_URL=

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0

# The proposal calls for "TLS-secured message brokers" for inter-agent
# communication. This is that switch.
REDIS_TLS=false
REDIS_TLS_REJECT_UNAUTHORIZED=true
REDIS_TLS_CA=

# Namespaces every key. Keep the trailing colon.
REDIS_KEY_PREFIX=daiap:
REDIS_CONNECT_TIMEOUT=10s
REDIS_MAX_RETRIES_PER_REQUEST=3


# ═══════════════════════════════════════════════════════════════════════════
#  JWT                                       [REQUIRED IN PRODUCTION]
#
#  Access and refresh tokens are signed with DIFFERENT secrets. Reusing one
#  would let a stolen refresh token be replayed as an access token, defeating
#  rotation and reuse detection entirely.
#
#  Generate both with:  npm run generate:secrets -- --write
# ═══════════════════════════════════════════════════════════════════════════

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Short by design: revocation latency is bounded by this value.
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

JWT_ISSUER=daiap
JWT_AUDIENCE=daiap-api
JWT_ALGORITHM=HS256
JWT_CLOCK_TOLERANCE=5


# ═══════════════════════════════════════════════════════════════════════════
#  SECURITY                                  [REQUIRED IN PRODUCTION]
# ═══════════════════════════════════════════════════════════════════════════

# ── Password hashing ───────────────────────────────────────────────────────
# argon2id is the OWASP first choice and the default. Switch to `scrypt` only
# if the argon2 native addon cannot be built on your deployment target —
# existing hashes stay verifiable either way and are upgraded on next sign-in.
PASSWORD_HASH_ALGORITHM=argon2id

# Memory cost in KiB. 65536 = 64 MiB, the OWASP baseline. Raising it makes
# offline cracking proportionally more expensive and sign-in proportionally
# slower; measure before changing.
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=4

# ── Password policy ────────────────────────────────────────────────────────
PASSWORD_MIN_LENGTH=12
PASSWORD_MAX_LENGTH=128
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_NUMBER=true
# Off by default: symbol requirements push users toward `Password1!` patterns
# that composition rules accept and attackers try first. Length does more.
PASSWORD_REQUIRE_SYMBOL=false

# Optional server-side pepper mixed into every password hash. Because it lives
# outside the database, a stolen dump alone is not enough for an offline attack.
# CHANGING IT INVALIDATES EVERY STORED PASSWORD.
PASSWORD_PEPPER=

# ── Keys ───────────────────────────────────────────────────────────────────
# AES-256-GCM key for encrypted columns. Accepts 64 hex chars, 32 base64 bytes,
# or any passphrase (stretched with scrypt).
# ROTATING IT ORPHANS EVERY EXISTING CIPHERTEXT.
ENCRYPTION_KEY=

# HMAC key protecting the tamper-evident audit log hash chain. Lives outside the
# database on purpose: an attacker with database access alone cannot recompute a
# consistent chain to hide an edit.
# ROTATING IT MAKES EVERY EXISTING RECORD FAIL VERIFICATION.
AUDIT_HASH_SECRET=

# ── Account lockout ────────────────────────────────────────────────────────
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_DURATION=15m
LOGIN_ATTEMPT_WINDOW=15m

# ── One-time tokens ────────────────────────────────────────────────────────
EMAIL_VERIFICATION_TTL=24h
PASSWORD_RESET_TTL=1h
INVITATION_TTL=7d

# Blocks unverified accounts from everything. Off by default so a new
# installation is usable before SMTP is configured; turn on for production.
REQUIRE_EMAIL_VERIFICATION=false

# ── API keys ───────────────────────────────────────────────────────────────
API_KEY_PREFIX=daiap_sk
API_KEY_DEFAULT_TTL=365d

# ── Refresh token cookie ───────────────────────────────────────────────────
# httpOnly means script cannot read it, so an XSS flaw in the React app cannot
# exfiltrate a 30-day credential. Non-browser clients use the response body copy.
REFRESH_TOKEN_COOKIE_ENABLED=true
REFRESH_TOKEN_COOKIE_NAME=daiap_rt
REFRESH_TOKEN_COOKIE_DOMAIN=

# BOTH MUST CHANGE FOR PRODUCTION: COOKIE_SECURE=true, COOKIE_SAME_SITE=strict
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_SECRET=

# ── CORS ───────────────────────────────────────────────────────────────────
# Comma-separated. `*` allows any origin and is development-only — with
# credentials enabled it lets any website act as a signed-in user.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
CORS_CREDENTIALS=true

# ── Network ────────────────────────────────────────────────────────────────
# Number of reverse proxies in front of the app. MUST be correct: the IP
# allowlist and the rate limiter both read the resolved client IP, and a wrong
# value makes both either useless or spoofable.
#   0     no proxy (direct)
#   1     one proxy (nginx, a single load balancer)  <- typical
#   true  trust the whole X-Forwarded-For chain (only on a trusted network)
TRUST_PROXY=1

# Master switch for per-workspace IP allowlisting (proposal module 6.1).
# Individual workspaces still opt in themselves.
ENFORCE_IP_ALLOWLIST=true

HELMET_ENABLED=true
HSTS_MAX_AGE=15552000


# ═══════════════════════════════════════════════════════════════════════════
#  RATE LIMITING  (proposal module 6.14 foundation)
# ═══════════════════════════════════════════════════════════════════════════

THROTTLE_ENABLED=true

# General API traffic, per authenticated principal or source IP.
THROTTLE_TTL=60s
THROTTLE_LIMIT=120

# Credential endpoints: sign-in, refresh, password reset. Deliberately tight.
THROTTLE_AUTH_TTL=15m
THROTTLE_AUTH_LIMIT=10

# Endpoints that send email, so the platform cannot be used as a spam relay.
THROTTLE_EMAIL_TTL=1h
THROTTLE_EMAIL_LIMIT=5


# ═══════════════════════════════════════════════════════════════════════════
#  OUTBOUND EMAIL
#
#  `log` prints messages — including the verification and invitation links —
#  straight to the console and sends nothing. That is the right default for
#  development: it removes the usual onboarding blocker where a new contributor
#  cannot complete registration because nobody gave them SMTP credentials.
# ═══════════════════════════════════════════════════════════════════════════

# log | smtp
MAIL_TRANSPORT=log

MAIL_FROM_NAME="AI Agent Platform"
MAIL_FROM_ADDRESS=no-reply@localhost
MAIL_REPLY_TO=

# Required when MAIL_TRANSPORT=smtp.
SMTP_HOST=
SMTP_PORT=587
# true for implicit TLS on 465; false for STARTTLS on 587.
SMTP_SECURE=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_REJECT_UNAUTHORIZED=true


# ═══════════════════════════════════════════════════════════════════════════
#  BOOTSTRAP & LIMITS
# ═══════════════════════════════════════════════════════════════════════════

# `npm run seed` provisions a platform administrator when BOTH are set. There is
# deliberately no built-in default admin account.
# The password is checked against the live policy, so it must be a real one.
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=
PLATFORM_ADMIN_NAME="Platform Administrator"

# Seeds a demo workspace with five accounts and two custom roles that
# demonstrate the RBAC model. Ignored when NODE_ENV=production.
SEED_DEMO_DATA=false

# Workspaces one non-admin user may own.
MAX_OWNED_ORGANIZATIONS=5
# Members per workspace. 0 means unlimited.
MAX_MEMBERS_PER_ORGANIZATION=0


###############################################################################
#  LATER PHASES — not read by any code yet
#
#  Listed so the shape of the finished system is visible from day one, and so
#  infrastructure can be provisioned ahead of the module that needs it.
###############################################################################

# ── Phase 2: documents, embeddings, secure RAG ─────────────────────────────
# AI_SERVICE_URL=http://localhost:8000        # Python FastAPI service
# AI_SERVICE_API_KEY=                          # issued from the workspace UI
# AI_SERVICE_TIMEOUT=120s
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=
# QDRANT_COLLECTION_PREFIX=daiap_
# EMBEDDING_MODEL=nomic-embed-text
# EMBEDDING_DIMENSIONS=768
# STORAGE_DRIVER=local                         # local | s3 | minio
# STORAGE_LOCAL_PATH=./storage
# S3_ENDPOINT=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# MAX_UPLOAD_SIZE=50mb
# ALLOWED_UPLOAD_MIME_TYPES=application/pdf,text/plain,application/vnd.openxmlformats-officedocument.wordprocessingml.document

# ── Phase 3: local LLM gateway, agents, PII redaction ──────────────────────
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_DEFAULT_MODEL=llama3:8b
# OLLAMA_TIMEOUT=300s
# LLM_MAX_CONTEXT_TOKENS=8192
# LLM_DEFAULT_TEMPERATURE=0.7
# PRESIDIO_ANALYZER_URL=http://localhost:5001
# PRESIDIO_ANONYMIZER_URL=http://localhost:5002
# PII_DEFAULT_ENTITIES=PERSON,EMAIL_ADDRESS,PHONE_NUMBER,CREDIT_CARD,IBAN_CODE,US_SSN
# PII_FAIL_CLOSED=true
# AGENT_MEMORY_WINDOW=20

# ── Phase 4: workflow engine, tools, websockets ────────────────────────────
# BULLMQ_PREFIX=daiap-queue
# BULLMQ_DEFAULT_ATTEMPTS=3
# BULLMQ_BACKOFF_DELAY=5s
# WORKFLOW_MAX_STEPS=50
# WORKFLOW_MAX_DURATION=600s
# DLQ_RETENTION=30d
# WEBSOCKET_PATH=/ws
# WEBSOCKET_PING_INTERVAL=30s
# TOOL_EXECUTION_TIMEOUT=60s

# ── Phase 5: quotas, metrics, mTLS ─────────────────────────────────────────
# DEFAULT_MONTHLY_TOKEN_QUOTA=1000000
# AGENT_LOOP_DETECTION_THRESHOLD=25
# METRICS_ENABLED=true
# METRICS_PATH=/metrics
# OTEL_EXPORTER_OTLP_ENDPOINT=
# MTLS_ENABLED=false
# MTLS_CA_CERT=
# MTLS_SERVER_CERT=
# MTLS_SERVER_KEY=
# AUDIT_RETENTION_DAYS=365
